page {
  width: 100%;
  height: 100%;
  background: #eee7de;
  color: #2e2a24;
  font-family: "Songti SC", "STSong", serif;
}

button {
  font-family: inherit;
}

.screen {
  position: relative;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
}

.design {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  display: block;
  pointer-events: none;
  z-index: 1;
}

.hotspot {
  position: absolute;
  display: block;
  z-index: 10;
  background: transparent;
}

.toast {
  position: fixed;
  left: 50%;
  bottom: 170rpx;
  transform: translateX(-50%);
  z-index: 30;
  padding: 18rpx 30rpx;
  border-radius: 40rpx;
  color: #fff;
  background: rgba(35, 30, 24, .82);
  font-size: 26rpx;
  white-space: nowrap;
}
