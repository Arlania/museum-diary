.detail-page {
  min-height: 100vh;
  padding-bottom: 150rpx;
  box-sizing: border-box;
  background: linear-gradient(145deg,#d8c5ab,#c8b291);
}
.detail-nav {
  position: relative;
  z-index: 5;
  height: calc(112rpx + env(safe-area-inset-top));
  padding: env(safe-area-inset-top) 34rpx 0;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: rgba(216,196,168,.94);
  border-bottom: 1rpx solid rgba(91,66,35,.2);
}
.detail-nav-title {
  font-size: 38rpx;
  letter-spacing: 5rpx;
}
.back {
  width: 80rpx;
  font-size: 58rpx;
}
.top-more {
  width: 80rpx;
  text-align: right;
  font-size: 34rpx;
  letter-spacing: 4rpx;
}
.gallery-light {
  position: relative;
  min-height: calc(100vh - 112rpx);
  padding: 150rpx 70rpx 45rpx;
  box-sizing: border-box;
  overflow: hidden;
}
.lamp {
  position: absolute;
  top: -15rpx;
  left: 50%;
  z-index: 3;
  width: 105rpx;
  height: 40rpx;
  transform: translateX(-50%);
  border-radius: 50%;
  background: #f9f3e8;
  border: 10rpx solid #a98c68;
  box-shadow: 0 8rpx 22rpx rgba(49,31,14,.35);
}
.light-cone {
  position: absolute;
  top: 12rpx;
  left: 50%;
  width: 560rpx;
  height: 620rpx;
  transform: translateX(-50%);
  background: radial-gradient(ellipse at top,rgba(255,242,210,.78),rgba(255,233,193,.15) 58%,transparent 75%);
  pointer-events: none;
}
.exhibit-number {
  position: absolute;
  top: 98rpx;
  left: 0;
  right: 0;
  text-align: center;
  color: #876438;
  font-family: Georgia, serif;
  font-size: 30rpx;
  letter-spacing: 2rpx;
}
.rope {
  height: 2rpx;
  margin-bottom: 28rpx;
  background: #a77c43;
  box-shadow: 0 3rpx 5rpx rgba(63,39,12,.25);
}
.photo-frame {
  width: 440rpx;
  height: 550rpx;
  margin: 0 auto 42rpx;
  padding: 24rpx;
  box-sizing: border-box;
  background: #eee5d7;
  box-shadow: 0 15rpx 25rpx rgba(63,42,20,.28);
}
.photo-frame image {
  width: 100%;
  height: 100%;
  display: block;
}
.description-card {
  padding: 30rpx 0 0;
  overflow: hidden;
  text-align: center;
  border: 2rpx solid rgba(140,106,63,.34);
  border-radius: 25rpx;
  background: rgba(241,230,214,.9);
  box-shadow: 0 15rpx 28rpx rgba(63,42,20,.18);
}
.exhibit-title {
  font-size: 39rpx;
  letter-spacing: 4rpx;
}
.exhibit-date {
  margin-top: 10rpx;
  font-size: 24rpx;
}
.tiny-ornament {
  margin: 10rpx 0;
  color: #ae8958;
}
.exhibit-description {
  padding: 0 30rpx 25rpx;
  font-size: 25rpx;
  line-height: 1.75;
}
.hall-link {
  padding: 23rpx 30rpx;
  display: flex;
  justify-content: space-between;
  border-top: 1rpx solid rgba(153,121,80,.25);
  text-align: left;
  font-size: 24rpx;
}
.scroll-paper {
  position: relative;
  min-height: 800rpx;
  padding: 95rpx 60rpx;
  box-sizing: border-box;
  background: linear-gradient(90deg,#d4b98d,#eee0c5 5%,#eee0c5 95%,#c7aa78);
  border-top: 25rpx solid #a87e4c;
  border-bottom: 25rpx solid #a87e4c;
  box-shadow: 0 18rpx 35rpx rgba(59,38,17,.25);
}
.scroll-title {
  text-align: center;
  font-size: 36rpx;
  letter-spacing: 3rpx;
}
.scroll-paper .exhibit-date {
  text-align: center;
}
.story {
  margin-top: 62rpx;
  font-size: 27rpx;
  line-height: 1.8;
}
.story text {
  display: block;
  margin-bottom: 30rpx;
}
.gramophone-frame {
  position: relative;
  width: 490rpx;
  height: 500rpx;
  margin: 0 auto 38rpx;
  overflow: hidden;
  border-radius: 15rpx;
  box-shadow: 0 16rpx 35rpx rgba(55,36,16,.28);
}
.gramophone-frame image {
  width: 100%;
  height: 100%;
  display: block;
}
.play-button {
  position: absolute;
  left: 50%;
  bottom: 25rpx;
  width: 76rpx;
  height: 76rpx;
  transform: translateX(-50%);
  line-height: 76rpx;
  text-align: center;
  border-radius: 50%;
  background: rgba(248,239,223,.9);
  color: #694822;
  font-size: 30rpx;
}
.detail-actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10;
  height: calc(135rpx + env(safe-area-inset-bottom));
  padding: 14rpx 15% env(safe-area-inset-bottom);
  box-sizing: border-box;
  display: flex;
  justify-content: space-between;
  background: rgba(211,192,164,.96);
  border-top: 1rpx solid rgba(117,86,49,.2);
}
.detail-actions button,
.action-button {
  width: 120rpx;
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: transparent;
  color: #322a22;
  font-size: 23rpx;
  line-height: 1.3;
}
.detail-actions button::after {
  border: 0;
}
.action-icon {
  font-size: 38rpx;
  margin-bottom: 4rpx;
}
