.nav-shell {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  height: calc(112rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  box-sizing: border-box;
  display: flex;
  background: rgba(248, 243, 235, .97);
  border-top: 1rpx solid rgba(139, 111, 76, .22);
  box-shadow: 0 -10rpx 30rpx rgba(66, 45, 23, .08);
  font-family: var(--font-display, "Source Han Serif SC", "Noto Serif SC", serif);
  font-weight: 400;
}
.nav-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  color: #6e6255;
}
.nav-icon {
  width: 52rpx;
  height: 46rpx;
  line-height: 46rpx;
  text-align: center;
  border: 2rpx solid currentColor;
  border-radius: 12rpx 12rpx 5rpx 5rpx;
  font-size: 24rpx;
}
.nav-label {
  margin-top: 7rpx;
  font-size: 23rpx;
}
.nav-item.active {
  color: #8b642a;
  font-weight: 500;
}
.nav-hover {
  background: rgba(149, 111, 57, .08);
}
