<view class="nav-shell">
  <navigator
    wx:for="{{items}}"
    wx:key="key"
    class="nav-item {{active === item.key ? 'active' : ''}}"
    url="{{item.url}}"
    open-type="redirect"
    hover-class="nav-hover"
  >
    <view class="nav-icon">{{item.icon}}</view>
    <view class="nav-label">{{item.label}}</view>
  </navigator>
</view>
